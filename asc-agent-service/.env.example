# ASC Agent Service — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# GitHub
# ─────────────────────────────────────────────
# Personal Access Token with repo read/write scope
GITHUB_TOKEN=

# GitHub organisation name (e.g. ASC-Creative)
GITHUB_ORG=ASC-Creative

# ─────────────────────────────────────────────
# Gemini API (Google AI Studio)
# ─────────────────────────────────────────────
GEMINI_API_KEY=

# Cron expression for scheduled heartbeat reports (default: Monday 9:00 AM)
# Format: minute hour day month weekday — see https://crontab.guru
HEARTBEAT_REPORT_CRON=0 9 * * 1

# ─────────────────────────────────────────────
# Claude API (Anthropic)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# Mattermost
# ─────────────────────────────────────────────
# Your Mattermost instance base URL (no trailing slash)
MATTERMOST_URL=

# Bot user token (from Mattermost bot account)
MATTERMOST_BOT_TOKEN=

# Outgoing webhook token — used to validate incoming webhook requests from Mattermost
MATTERMOST_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# Mattermost Channel IDs
# ─────────────────────────────────────────────
# Find channel IDs in Mattermost: Channel Settings → View Info
MATTERMOST_INTAKE_CHANNEL_ID=
MATTERMOST_ALERTS_CHANNEL_ID=
